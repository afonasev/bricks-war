{
  "name": "bricks-war",
  "version": "1.2.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:prototype": "playwright test -c playwright.prototype.config.ts",
    "network:service": "tsx server/main.ts",
    "dev:network": "tsx tools/network-dev.ts",
    "build:server": "npm run check:server && node tools/build-network-service.mjs",
    "check:server": "tsc -p tsconfig.server.json",
    "test:network": "playwright test -c playwright.network.config.ts",
    "test:ui": "python3 tools/qa.py ui",
    "test:ui:unit": "python3 tools/qa.py unit-ui",
    "test:focused": "python3 tools/qa.py focused",
    "test:full": "python3 tools/qa.py full",
    "test:qa-tooling": "python3 -m unittest discover -s tests/qa -v",
    "desktop:keygen": "node scripts/desktop/keygen.mjs",
    "desktop:prepare": "npm run build && node scripts/desktop/prepare.mjs",
    "desktop:dev": "electron .",
    "desktop:build": "npm run desktop:prepare && electron-builder --mac --win --publish never",
    "desktop:build:mac": "npm run desktop:prepare && electron-builder --mac --publish never",
    "desktop:build:win": "npm run desktop:prepare && electron-builder --win --publish never",
    "test:desktop": "node --test tests/desktop/*.test.mjs",
    "desktop:publish": "node scripts/desktop/publish.mjs --installers",
    "desktop:publish:content": "node scripts/desktop/publish.mjs",
    "desktop:release": "node scripts/desktop/github-release.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "phaser": "3.90.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "5.9.2",
    "vite": "6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "3.2.7",
    "js-yaml": "4.1.1"
  },
  "main": "electron/main.mjs",
  "description": "Bricks War desktop and browser game",
  "author": "Bricks War"
}
